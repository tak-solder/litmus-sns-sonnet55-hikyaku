# ローカル開発用の PostgreSQL。検索（ADR 20261030-search-pg-bigm）用に pg_bigm をソースからビルドして入れる
FROM postgres:17

ARG PG_BIGM_VERSION=v1.2-20250903

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git libicu-dev postgresql-server-dev-17 \
    && git clone --depth 1 --branch "${PG_BIGM_VERSION}" https://github.com/pgbigm/pg_bigm.git /tmp/pg_bigm \
    && make -C /tmp/pg_bigm USE_PGXS=1 \
    && make -C /tmp/pg_bigm USE_PGXS=1 install \
    && rm -rf /tmp/pg_bigm \
    && apt-get purge -y --auto-remove build-essential git libicu-dev postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*
