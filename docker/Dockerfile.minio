# ローカル開発用の S3 互換ストレージ。
# 公式イメージ（Docker Hub / quay.io）とバイナリ配布が終了しているため、ソースからビルドする。
# コンソール付きの最後のコミュニティリリースに固定している。
FROM golang:1.24 AS build

ARG MINIO_RELEASE=RELEASE.2025-04-22T22-12-26Z

RUN GOBIN=/out go install "github.com/minio/minio@${MINIO_RELEASE}"

FROM debian:trixie-slim

COPY --from=build /out/minio /usr/local/bin/minio

EXPOSE 9000 9001
ENTRYPOINT ["minio"]
