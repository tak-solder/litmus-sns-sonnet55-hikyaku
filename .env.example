# ローカル開発用の値。compose の api はここと同じ値を environment で受け取る
# ホストで pnpm を直接実行するときは、このファイルを .env にコピーして読み込む

# API
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/litmus_sns

# テスト（テストごとに一意名の DB を作る管理用接続）
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Mailpit（UI: http://localhost:8025）
SMTP_HOST=localhost
SMTP_PORT=1025

# MinIO（コンソール: http://localhost:9001）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
